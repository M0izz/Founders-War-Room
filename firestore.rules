rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Sessions collection security rules
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Startups collection & version subcollections security rules
    match /startups/{startupId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /versions/{versionId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/startups/$(startupId)).data.userId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
        );
      }
    }
  }
}
